--==================================================
-- ANTI-AFK
-- OTOMATIS ON SAAT SCRIPT DIJALANKAN
--==================================================

local AntiAFKEnabled = true
local LastActivity = tick()
local LastAntiAFK = tick()

-- Hapus koneksi Anti-AFK lama milik script ini
if getgenv().BALJITOTAntiAFKConnection then
    pcall(function()
        getgenv().BALJITOTAntiAFKConnection:Disconnect()
    end)
    getgenv().BALJITOTAntiAFKConnection = nil
end

-- Reset timer ketika user benar-benar melakukan input
local UserInputService = game:GetService("UserInputService")

UserInputService.InputBegan:Connect(function()
    LastActivity = tick()
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Gamepad1 then
        LastActivity = tick()
    end
end)

-- Menangani event idle
getgenv().BALJITOTAntiAFKConnection =
    LocalPlayer.Idled:Connect(function()

        if not AntiAFKEnabled then
            return
        end

        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)

        LastAntiAFK = tick()

    end)

-- Cadangan: cek secara berkala
task.spawn(function()

    while AntiAFKEnabled do

        task.wait(5)

        local idleTime = tick() - LastActivity

        if idleTime >= 300
            and tick() - LastAntiAFK >= 60 then

            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)

            LastAntiAFK = tick()

        end

    end

end)

