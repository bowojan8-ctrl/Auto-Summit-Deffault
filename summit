--==================================================
-- AUTO TP
--==================================================

local autoTog = true
local autoRunning = false

local AutoBtn = CreateButton(
    "Auto TP Mount Sumbing: ON (Running...)",
    function()
    end
)

local function StartAutoTP()

    if autoRunning or not autoTog then
        return
    end

    autoRunning = true

    AutoBtn.Text = "Auto TP Mount Sumbing: ON (Running...)"
    AutoBtn.BorderColor3 = Color3.fromRGB(150, 150, 150)

    task.spawn(function()

        while autoTog do

            for i, cp in ipairs(checkpoints) do

                if not autoTog then
                    break
                end

                teleportTo(cp)

                if i == #checkpoints then

                    task.wait(0.5)

                    if not autoTog then
                        break
                    end

                    task.wait(3)

                    pcall(function()
                        ResetToBasecamp:FireServer()
                    end)

                    task.wait(3)

                else

                    task.wait(1)

                end

            end

        end

        autoRunning = false

    end)

end

AutoBtn.MouseButton1Click:Connect(function()

    autoTog = not autoTog

    if autoTog then

        AutoBtn.Text = "Auto TP Mount Sumbing: ON (Running...)"
        AutoBtn.BorderColor3 = Color3.fromRGB(150, 150, 150)

        StartAutoTP()

    else

        AutoBtn.Text = "Auto TP Mount Sumbing: OFF"
        AutoBtn.BorderColor3 = Color3.fromRGB(255, 255, 255)

    end

end)

--==================================================
-- AUTO START
--==================================================

StartAutoTP()

