--==================================================
-- TELEPORT FUNCTION
--==================================================

local function teleportTo(position)

    pcall(function()

        local character = LocalPlayer.Character

        if not character then
            return
        end

        local root =
            character:FindFirstChild("HumanoidRootPart")

        if not root then
            return
        end

        root.CFrame = CFrame.new(position)

    end)

end

--==================================================
-- AUTO SUMMIT
--==================================================

task.spawn(function()

    while getgenv().BALJITOT_RUNNING do

        if AutoSummitEnabled then

            for i, position in ipairs(checkpoints) do

                if not getgenv().BALJITOT_RUNNING then
                    break
                end

                if not AutoSummitEnabled then
                    break
                end

                teleportTo(position)

                if i == #checkpoints then

                    -- Tunggu summit terdaftar
                    task.wait(4)

                    if not AutoSummitEnabled then
                        break
                    end

                    -- Reset checkpoint ke basecamp
                    pcall(function()
                        ResetToBasecamp:FireServer()
                    end)

                    -- Tunggu setelah reset
                    task.wait(6)

                else

                    task.wait(4)

                end

            end

        end

        task.wait(0.5)

    end

end)

--==================================================
-- AUTO RECONNECT
-- DISCONNECT / ERROR SAJA
--==================================================

if ReconnectEnabled then

    pcall(function()

        TeleportService:SetTeleportGui(nil)

    end)

    TeleportService.TeleportInitFailed:Connect(
        function(player, teleportResult, errorMessage)

            if player ~= LocalPlayer then
                return
            end

            warn(
                "[BALJITOT] Reconnect gagal: ",
                tostring(teleportResult),
                tostring(errorMessage)
            )

            task.wait(6)

            if ReconnectEnabled then

                pcall(function()

                    TeleportService:Teleport(
                        PlaceId,
                        LocalPlayer
                    )

                end)

            end

        end
    )

    -- Coba kembali ke experience apabila Roblox
    -- mengirimkan kondisi teleport/disconnect tertentu.
    game:GetService("GuiService").ErrorMessageChanged:Connect(
        function(message)

            if not ReconnectEnabled then
                return
            end

            if message and message ~= "" then

                warn(
                    "[BALJITOT] Connection/Error: ",
                    tostring(message)
                )

                task.wait(6)

                pcall(function()

                    TeleportService:Teleport(
                        PlaceId,
                        LocalPlayer
                    )

                end)

            end

        end
    )

end

